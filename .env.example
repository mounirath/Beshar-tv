# GEMINI_API_KEY: Clé optionnelle pour enrichissement métadonnées
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: URL publique de l'application ou déploiement Vercel
APP_URL="https://your-beshare-tv.vercel.app"

# SUPABASE CONFIGURATION (Backend central BeShare TV)
# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Clé publique anonyme (Anon Key) - Utilisée par le panneau Web et l'app Android avec RLS
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY"

# Clé secrète de service (Service Role) - UNIQUEMENT pour Edge Functions côté serveur (JAMAIS dans le client ou l'APK Android)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY"

# Email de l'administrateur initial pour attribution automatique du rôle admin
BE_SHARE_ADMIN_EMAIL="admin@besharetv.com"
